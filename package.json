{
  "name": "danlang",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:docs": "pnpm --filter docs dev",
    "build:docs": "pnpm --filter docs build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "verify": "pnpm typecheck && pnpm test",
    "vscode:install": "pnpm --filter danlang-vscode install:local"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
