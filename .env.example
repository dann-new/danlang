# Only needed for the Studio (apps/studio). Copy to .env.local and fill in. Never commit .env.local.

# The classifier (Jev, through OpenRouter's Decisions API). Used to sort each test message.
JEV_API_KEY=

# Optional: lets the Studio also ask the big AI (through OpenRouter) when a rule says "model".
OPENROUTER_API_KEY=

# Not used yet; kept for future provider adapters.
GEMINI_API_KEY=
OPENAI_API_KEY=
