# A shop assistant for a small online store, written in danlang.
# Every message starts at "flow main" and goes down the list. The first rule that fits wins.
# "model" means: let the big AI answer. Everything else is answered for free.

use "./shop.dan"

# Set by the app: did the classifier answer, or did it fail?
field source = [classifier, fallback]

# What the classifier tells us about each message. The descriptions are sent to the classifier.
field topic "What is the message about?" = [
  greeting "The person says hello or makes small talk.",
  orders "About an existing order: where it is, when it arrives, its status.",
  returns "The person wants to send something back or get a refund.",
  off_topic "Nothing to do with the shop, its orders or returns.",
  other "Anything else about the shop.",
]

field action "What does the person want done?" = [
  track_order "Find out where an order is or when it arrives.",
  return_item "Return an item or ask for a refund.",
  other "Anything else.",
]

# Every == test needs the classifier to be at least this sure, unless the rule says otherwise.
confidence = 80%

let hello_messages = [
  "Hi! How can I help with your order today?",
  "Hello! Ask me about an order or a return.",
]

let off_topic_messages = [
  "Sorry, I can only help with orders and returns.",
  "That's outside what I do! Ask me about an order or a return.",
]

flow main
  classifier-down: when source == fallback -> model
  hello: when topic == greeting -> reply hello_messages
  off-topic: when topic == off_topic >= 90% -> refuse off_topic_messages   # be extra sure before saying no
  shop: when topic == [orders, returns] -> shop
  open: else -> model
