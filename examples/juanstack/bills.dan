# Taxes, money, expenses and invoices.

check amount = /(₱|php|p\s?\d)|\b\d[\d,]*(\.\d+)?\s?(k|pesos?|php)?\b/i

let expense_question = [
  "Sure! How much was it, and who did you pay? For example: \"₱1,500 to Meralco for electricity.\"",
  "Got it! How much did you spend, and on what?",
  "Okay! What was the amount, and who was it paid to?",
]

let invoice_question = [
  "Sure! Who is the invoice for, what is it for, and how much? For example: \"Acme Inc, October bookkeeping, ₱25,000.\"",
  "Happy to help! Who should I bill, for what, and how much?",
]

flow bills
  tax-due: when action == tax_due >= sure -> direct tax_due
  to-approve: when action == returns_to_approve >= sure -> direct returns_to_approve
  money: when action == money_summary >= sure -> direct money_summary

  expense: when action == log_expense >= sure
    has-amount: when has amount -> model
    answer: when asked expense_question -> model
    ask-amount: else -> ask expense_question

  invoice: when action == create_invoice >= sure
    has-amount: when has amount -> model
    answer: when asked invoice_question -> model
    ask-details: else -> ask invoice_question

  2307: when action == make_2307 >= sure -> model
  open: else -> model
