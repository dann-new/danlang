# Juan's chat brain, written in danlang.
# Every message starts at "flow main" and goes down the list. The first line that fits wins.
# "model" means: let the AI (Gemini) answer. Everything else is answered for free, without the AI.

use "./bills.dan"
use "./schedule.dan"

# What Jev can tell us about a message.
field source = [rules, jev, fallback]
field intent = [bir_forms, schedule_task, bank_statement, business_qa, general, out_of_scope]
field action = [tax_due, returns_to_approve, money_summary, schedule_read, schedule_create, log_expense, make_2307, create_invoice, other]

# How sure Jev must be (1 = 100% sure).
let sure = 0.8
let very_sure = 0.9

let off_topic_messages = [
  "I can only help with your business: your schedule, Books, money and BIR forms. Try \"How much tax do I owe?\"",
  "Sorry, that's outside what I do! I handle your schedule, Books, money and BIR forms.",
  "I'm your business assistant, so I can't help with that one. Ask me about taxes, invoices or your schedule!",
]

flow main
  jev-down: when source == fallback -> model
  off-topic: when intent == out_of_scope >= very_sure and action == other -> refuse off_topic_messages
  money: when intent == [bir_forms, business_qa] -> bills
  schedule: when intent == schedule_task -> schedule
  open: else -> model
