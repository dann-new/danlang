{
  "comments": { "lineComment": "#" },
  "brackets": [
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(flow\\s+\\w+|[A-Za-z0-9_][A-Za-z0-9_-]*:\\s*when\\b(?!.*->).*)\\s*(#.*)?$",
    "decreaseIndentPattern": "^\\s*$"
  },
  "onEnterRules": [],
  "wordPattern": "[A-Za-z0-9_][A-Za-z0-9_-]*"
}
